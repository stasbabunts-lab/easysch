generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Teacher {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String
  code                   String    @unique
  alias                  String?   @unique // custom public URL slug (lowercase a-z0-9-)
  timezone               String    @default("Europe/Moscow")
  lastPolledAt           DateTime?
  createdAt              DateTime  @default(now())
  teacherReminderMinutes String    @default("60")
  studentReminderMinutes String    @default("60")
  telegramChatId         String?
  displayName            String?   // shown on public schedule page instead of name
  paymentMinAmount       Int?      // min transaction to consider (kopecks), null = no limit
  paymentMaxAmount       Int?      // max transaction to consider (kopecks), null = no limit
  telegramUsername       String?   // @username for public "write" button
  phone                  String?   // optional phone for public "call" button
  paymentDetails         String?   // free-text: card number, IBAN, phone for Pay, etc.
  postLessonNote         String?   // optional 4th line in post-lesson payment reminder
  subscriptionExpiresAt  DateTime? // null = never activated; set on registration (14-day trial)

  slots                AvailabilitySlot[]
  students             Student[]
  lessons              Lesson[]
  payments             Payment[]
  bankAccounts         BankAccount[]
  notificationLogs     NotificationLog[]
  subscriptionPayments SubscriptionPayment[]
}

model BankAccount {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bankType  String   // "monobank" | "privatbank" | "creditagricole" | "mock"
  label     String   // user label: "Mono картка", "Приват для учнів"
  creds     String   // JSON credentials (never returned to client)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AvailabilitySlot {
  id               String   @id @default(cuid())
  teacherId        String
  teacher          Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date             String   // "YYYY-MM-DD" — конкретная дата события
  startTime        String   // "HH:MM"
  endTime          String   // "HH:MM"
  durationMin      Int      @default(60)
  isRecurring      Boolean  @default(false)
  recurringGroupId String?  // общий UUID для серии повторяющихся событий
  isActive         Boolean  @default(true)
  isGroup          Boolean  @default(false)
  showAsFree       Boolean  @default(false) // group slots: show as free in public schedule
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id])

  lessons       Lesson[]
  groupStudents GroupSlotStudent[]
}

model Student {
  id             String   @id @default(cuid())
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name           String
  code           String   @unique
  telegramId     String?
  telegramHandle String?
  lessonPrice              Int
  groupLessonPrice         Int?
  paymentOffset            Int
  balanceAdjustmentKopecks Int      @default(0) // manual correction to computed balance
  sendPaymentReminder      Boolean  @default(true) // send Telegram payment reminder after each lesson
  paymentDetails           String?  // overrides teacher.paymentDetails for this student
  notes                    String?
  createdAt      DateTime @default(now())

  lessons         Lesson[]
  payments        Payment[]
  paymentRequests PaymentRequest[]
  slots           AvailabilitySlot[]
  groupSlots      GroupSlotStudent[]
}

model GroupSlotStudent {
  id        String           @id @default(cuid())
  slotId    String
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([slotId, studentId])
  @@index([slotId])
  @@index([studentId])
}

model Lesson {
  id                  String            @id @default(cuid())
  teacherId           String
  teacher             Teacher           @relation(fields: [teacherId], references: [id])
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  slotId              String?
  slot                AvailabilitySlot? @relation(fields: [slotId], references: [id])
  scheduledAt         DateTime
  durationMin         Int               @default(60)
  status              LessonStatus      @default(SCHEDULED)
  notes               String?
  reminderSent        Boolean           @default(false)
  reminderSentTeacher Boolean           @default(false)
  paymentReminderSent Boolean           @default(false)
  createdAt           DateTime          @default(now())

  payment Payment?
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model PaymentRequest {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  amountBase  Int
  amountTotal Int
  description String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  fulfilledBy Payment?
}

model NotificationLog {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String?
  studentName String
  type        String   // "lesson_reminder" | "payment_reminder" | "payment_confirmed" | "payment_request"
  text        String
  sentAt      DateTime @default(now())
}

model AppSettings {
  key   String @id
  value String
}

model SubscriptionPayment {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  amountBase  Int
  amountTotal Int
  offset      Int
  addDays     Int
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?

  @@index([teacherId])
  @@index([offset, status])
}

model Payment {
  id               String          @id @default(cuid())
  teacherId        String
  teacher          Teacher         @relation(fields: [teacherId], references: [id])
  studentId        String?
  student          Student?        @relation(fields: [studentId], references: [id])
  lessonId         String?         @unique
  lesson           Lesson?         @relation(fields: [lessonId], references: [id])
  paymentRequestId String?         @unique
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  amountReceived   Int
  bankTxId         String?         @unique
  matchedAt        DateTime?
  confirmedAt      DateTime        @default(now())
  source           String          @default("bank")
  notes            String?
  isIgnored        Boolean         @default(false) // excluded from balance calculations
}
