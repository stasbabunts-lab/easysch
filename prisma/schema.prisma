generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Teacher {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String
  code                   String    @unique
  alias                  String?   @unique // custom public URL slug (lowercase a-z0-9-)
  timezone               String    @default("Europe/Moscow")
  lastPolledAt           DateTime?
  createdAt              DateTime  @default(now())
  teacherReminderMinutes String    @default("60")
  studentReminderMinutes String    @default("60")
  telegramChatId         String?
  displayName            String?   // shown on public schedule page instead of name
  paymentMinAmount       Int?      // min transaction to consider (kopecks), null = no limit
  paymentMaxAmount       Int?      // max transaction to consider (kopecks), null = no limit
  telegramUsername       String?   // @username for public "write" button
  phone                  String?   // optional phone for public "call" button
  paymentDetails         String?   // free-text: card number, IBAN, phone for Pay, etc.
  postLessonNote         String?   // optional 4th line in post-lesson payment reminder
  lessonNoun             String    @default("заняття") // word for "lesson" in the post-lesson message (e.g. урок, сесія, візит)
  subscriptionExpiresAt  DateTime? // null = never activated; set on registration (14-day trial)
  weekStartsMonday       Boolean   @default(false) // schedule view: align weeks to Monday, dim past days
  showStudentPhone       Boolean   @default(false) // show an editable phone field in the client card
  referralSlug           String?   // marketing attribution: Campaign.slug captured at signup

  slots                AvailabilitySlot[]
  students             Student[]
  lessons              Lesson[]
  payments             Payment[]
  bankAccounts         BankAccount[]
  notificationLogs     NotificationLog[]
  subscriptionPayments SubscriptionPayment[]
  reminders            Reminder[]
  dailyReminders       DailyReminder[]
}

// Personal Telegram reminder the teacher sets for themselves ("remind me of X
// at time T"). Delivered to teacher.telegramChatId by the cron dispatcher.
model Reminder {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  text      String
  remindAt  DateTime // Kyiv wall-clock stored as UTC (like Lesson.scheduledAt)
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sent, remindAt])
}

// Recurring daily reminder: one text delivered at every listed time, every day
// ("Спорт" at 14:00, 18:00, 21:00). Same delivery path as Reminder — the 5-min
// cron pushes it to teacher.telegramChatId.
model DailyReminder {
  id         String    @id @default(cuid())
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  text       String
  times      String    // "14:00,18:00,21:00" — Kyiv wall-clock, sorted, unique
  isActive   Boolean   @default(true)
  lastSentAt DateTime? // Kyiv wall-clock stored as UTC — the slot last delivered
  createdAt  DateTime  @default(now())

  @@index([teacherId])
}

// Marketing campaign / referral link. Share easy-sch.com/r/<slug>; clicks are
// counted on the redirect, signups are Teachers whose referralSlug == slug.
model Campaign {
  id        String   @id @default(cuid())
  slug      String   @unique // URL part, e.g. "teachersuperhub"
  label     String   // human note: where it was placed, e.g. "Teacher Supervision Hub — €50 post"
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

model BankAccount {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bankType  String   // "monobank" | "privatbank" | "creditagricole" | "mock"
  label     String   // user label: "Mono картка", "Приват для учнів"
  creds     String   // JSON credentials (never returned to client)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AvailabilitySlot {
  id               String   @id @default(cuid())
  teacherId        String
  teacher          Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date             String   // "YYYY-MM-DD" — конкретная дата события
  startTime        String   // "HH:MM"
  endTime          String   // "HH:MM"
  durationMin      Int      @default(60)
  isRecurring      Boolean  @default(false)
  recurringGroupId String?  // общий UUID для серии повторяющихся событий
  isActive         Boolean  @default(true)
  isGroup          Boolean  @default(false)
  showAsFree       Boolean  @default(false) // group slots: show as free in public schedule
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id])

  lessons       Lesson[]
  groupStudents GroupSlotStudent[]
}

model Student {
  id             String   @id @default(cuid())
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name           String
  code           String   @unique
  telegramId     String?
  telegramHandle String?
  phone          String?  // optional contact phone; shown in card only when teacher.showStudentPhone
  lessonPrice              Int
  groupLessonPrice         Int?
  paymentOffset            Int
  balanceAdjustmentKopecks Int      @default(0) // manual correction to computed balance
  sendPaymentReminder      Boolean  @default(true) // send Telegram payment reminder after each lesson
  paymentDetails           String?  // overrides teacher.paymentDetails for this student
  notes                    String?
  isArchived               Boolean  @default(false) // archived = hidden from active lists/pickers, history kept; restorable
  archivedAt               DateTime?
  createdAt      DateTime @default(now())

  lessons         Lesson[]
  payments        Payment[]
  paymentRequests PaymentRequest[]
  slots           AvailabilitySlot[]
  groupSlots      GroupSlotStudent[]
}

model GroupSlotStudent {
  id        String           @id @default(cuid())
  slotId    String
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([slotId, studentId])
  @@index([slotId])
  @@index([studentId])
}

model Lesson {
  id                  String            @id @default(cuid())
  teacherId           String
  teacher             Teacher           @relation(fields: [teacherId], references: [id])
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  slotId              String?
  slot                AvailabilitySlot? @relation(fields: [slotId], references: [id])
  scheduledAt         DateTime
  durationMin         Int               @default(60)
  status              LessonStatus      @default(SCHEDULED)
  notes               String?
  reminderSent        Boolean           @default(false)
  reminderSentTeacher Boolean           @default(false)
  paymentReminderSent Boolean           @default(false)
  createdAt           DateTime          @default(now())

  payment Payment?
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model PaymentRequest {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  amountBase  Int
  amountTotal Int
  description String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  fulfilledBy Payment?
}

model NotificationLog {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId     String?
  studentName   String
  type          String   // "lesson_reminder" | "payment_reminder" | "payment_confirmed" | "payment_request"
  text          String
  // Sum the student was actually asked for / confirmed, in kopecks. NULL for
  // notifications that carry no amount (lesson reminders) and for rows written
  // before this field existed.
  amountKopecks Int?
  sentAt        DateTime @default(now())
}

model AppSettings {
  key   String @id
  value String
}

model SubscriptionPayment {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  amountBase  Int
  amountTotal Int
  offset      Int
  addDays     Int
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?

  @@index([teacherId])
  @@index([offset, status])
}

model Payment {
  id               String          @id @default(cuid())
  teacherId        String
  teacher          Teacher         @relation(fields: [teacherId], references: [id])
  studentId        String?
  student          Student?        @relation(fields: [studentId], references: [id])
  lessonId         String?         @unique
  lesson           Lesson?         @relation(fields: [lessonId], references: [id])
  paymentRequestId String?         @unique
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  amountReceived   Int
  bankTxId         String?         @unique
  matchedAt        DateTime?
  confirmedAt      DateTime        @default(now())
  source           String          @default("bank")
  notes            String?
  isIgnored        Boolean         @default(false) // excluded from balance calculations
}
